ent groups</span></label></li>
            <li class=3D"azq-option"><input autocomplete=3D"off" id=3D"q6d"=
 name=3D"q6" type=3D"checkbox" value=3D"d"><label for=3D"q6d"><span>Azure P=
olicy</span></label></li>
            <li class=3D"azq-option"><input autocomplete=3D"off" id=3D"q6e"=
 name=3D"q6" type=3D"checkbox" value=3D"e"><label for=3D"q6e"><span>App reg=
istrations</span></label></li>
          </ul>
